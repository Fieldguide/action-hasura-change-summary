{
  "name": "action-hasura-change-summary",
  "version": "0.1.0",
  "private": true,
  "description": "Generate readable Hasura metadata change summaries",
  "engines": {
    "node": ">=20.x <21"
  },
  "packageManager": "pnpm@10.12.4",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest --watch",
    "test:ci": "jest",
    "all": "pnpm build && pnpm format:check && pnpm lint && pnpm package && pnpm test:ci"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fieldguide/action-hasura-change-summary.git"
  },
  "keywords": [
    "actions",
    "hasura",
    "metadata",
    "change",
    "summary",
    "diff"
  ],
  "author": "Nick Amoscato <nick@amoscato.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@hasura/metadata": "^1.0.2",
    "js-yaml": "^4.1.0",
    "jsondiffpatch": "^0.4.1",
    "lodash": "^4.17.21",
    "mustache": "^4.2.0",
    "prettier": "^2.7.1",
    "urlcat": "^2.0.4"
  },
  "devDependencies": {
    "@octokit/types": "^14.1.0",
    "@types/jest": "^28.1.6",
    "@types/js-yaml": "^4.0.5",
    "@types/lodash": "^4.14.189",
    "@types/mustache": "^4.2.1",
    "@types/node": "^20.17.30",
    "@types/prettier": "^2.6.1",
    "@typescript-eslint/parser": "^5.43.0",
    "@vercel/ncc": "^0.34.0",
    "eslint": "^8.28.0",
    "eslint-plugin-github": "^4.3.7",
    "eslint-plugin-jest": "^27.1.5",
    "html-validate": "^7.10.0",
    "jest": "^28.1.3",
    "ts-jest": "^28.0.7",
    "typescript": "^5.8.3"
  }
}
